#!/bin/sh
#==============================================================================#
# Author: Scott MacDonald
# Purpose: Opt-in removal of files orphaned by dotfiles migrations.
# Usage: ./dotfiles-cleanup [--dry-run]
#==============================================================================#
# vim: set filetype=sh :
set -e
set -u

# shellcheck disable=SC3040
(set -o pipefail 2> /dev/null) && set -o pipefail 

dry_run=0
for arg in "$@"; do
  case "$arg" in
    --dry-run) dry_run=1 ;;
    *)
      echo "usage: $(basename "$0") [--dry-run]" 1>&2
      exit 2
      ;;
  esac
done

# Print the sha256 of a file (first field only).
file_sha256() {
  if command -v sha256sum > /dev/null 2>&1; then
    sha256sum "$1" | cut -d ' ' -f 1
  elif command -v shasum > /dev/null 2>&1; then
    shasum -a 256 "$1" | cut -d ' ' -f 1
  else
    echo "error: need sha256sum or shasum to verify files" 1>&2
    exit 1
  fi
}

# Stanza: ~/.my_gitconfig, replaced by the ~/.gitconfig stub.
legacy="$HOME/.my_gitconfig"
if [ -e "$legacy" ]; then
  hash=$(file_sha256 "$legacy")
  # Only remove once bootstrap recorded that exact content in ~/.gitconfig.
  if ! grep -qxF "# migrated from ~/.my_gitconfig sha256=$hash" "$HOME/.gitconfig" 2> /dev/null; then
    # shellcheck disable=SC2088 # literal ~ in the message is intended
    echo '~/.my_gitconfig: not folded into ~/.gitconfig yet; re-run bootstrap.py first'
  elif [ "$dry_run" -eq 1 ]; then
    echo "would remove ~/.my_gitconfig"
  else
    answer=n
    # Without a TTY, the answer defaults to no.
    if [ -t 0 ]; then
      printf 'Remove ~/.my_gitconfig? [y/N] '
      read -r answer || answer=n
    fi
    case "$answer" in
      y | Y | yes) rm -f -- "$legacy" && echo "removed ~/.my_gitconfig" ;;
      *) echo "kept ~/.my_gitconfig" ;;
    esac
  fi
fi
